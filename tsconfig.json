{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./resources/*"],
      "@/components/*": ["./resources/js/Components/*"],
      "@/pages/*": ["./resources/js/Pages/*"],
      "@/types/*": ["./resources/types/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "resources/**/*.ts",
    "resources/**/*.tsx",
    "resources/**/*.js",
    "resources/**/*.jsx",
    "vite.config.ts",
    "resources/**/*.ts",
    "resources/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "storage",
    "bootstrap/cache"
  ]
}
